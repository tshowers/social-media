{
  "hosting": {
    "site": "todd-social-media",
    "public": "dist/social-media/browser",
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.csr.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9499
    },
    "firestore": {
      "port": 8480
    },
    "ui": {
      "enabled": true,
      "port": 4801
    }
  }
}
