{
  "name": "social-media",
  "version": "0.0.10",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node scripts/update-build-number.mjs",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "typecheck:cypress": "tsc -p tsconfig.cypress.json --noEmit --pretty false",
    "emulators:start": "firebase emulators:start --project taliferrotech --only auth,firestore",
    "e2e:app": "node scripts/e2e-port-check.js 4800 && start-server-and-test \"npm run start -- --port 4800\" http://localhost:4800 \"npm run cy:run -- --config baseUrl=http://localhost:4800\"",
    "e2e": "firebase emulators:exec --project taliferrotech --only auth,firestore \"npm run e2e:app\"",
    "serve:ssr:social-media": "node dist/social-media/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular/platform-server": "^19.2.25",
    "@angular/router": "^19.0.0",
    "@angular/ssr": "^19.2.27",
    "@taliferro/ui": "file:../../taliferro-ui",
    "express": "^4.22.3",
    "firebase": "^12.18.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.0.4",
    "@angular/cli": "^19.0.4",
    "@angular/compiler-cli": "^19.0.0",
    "@types/express": "^4.17.25",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^26.6.5",
    "cypress": "^13.17.0",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "start-server-and-test": "^2.1.5",
    "typescript": "~5.6.2"
  },
  "allowScripts": {
    "cypress@13.17.0": true
  }
}
